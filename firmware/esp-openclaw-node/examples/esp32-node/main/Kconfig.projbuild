menu "OpenClaw Example"

config CLAW_BOX_DISPLAY
    bool "Claw Buoy ILI9341 display (fixed Freenove WROOM pins)"
    depends on IDF_TARGET_ESP32
    default n
    help
        Enable only after checking the GPIO table in the repository root README.
        XPT2046 touch is enabled on a separate SPI bus; the return line is shared.
        Backlight control is GPIO17, not the board-reserved GPIO16.

endmenu
